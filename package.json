{
  "name": "tempest-archive",
  "version": "0.1.0",
  "private": true,
  "description": "Wiki colaborativa y grafo interactivo de Tensei Shitara Slime Datta Ken (Tempest Archive)",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @tempest-archive/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @tempest-archive/web test:e2e",
    "db:migrate": "supabase db push --remote --yes",
    "db:seed": "pnpm --filter @tempest-archive/web db:seed",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/database.types.ts",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
