# ==============================================================================
# TEMPEST ARCHIVE — Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo a `apps/web/.env.local` (y en la raíz `.env.local` para
# scripts de seed/CLI) y completa los valores reales.
# NUNCA subas archivos `.env` o `.env.local` al repositorio Git.
# ==============================================================================

# 1. URL pública de la aplicación
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="es"

# 2. Supabase (Público — Seguro en el cliente SOLO porque RLS está activo en todas las tablas)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-clave-publica-anon-o-publishable"

# 3. Supabase (SOLO SERVIDOR — NUNCA usar prefijo NEXT_PUBLIC_ ni exponer en el navegador)
# Usado exclusivamente para scripts administrativos locales (seed) o tareas privilegiadas.
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PROJECT_ID="tu-proyecto-ref"

# 4. Analítica (PostHog — Solo se inicializa tras consentimiento explícito del usuario)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# 5. Monitoreo de Errores (Sentry — Opcional en dev, activo en prod)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
